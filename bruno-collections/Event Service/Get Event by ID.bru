meta {
  name: Get Event by ID
  type: http
  seq: 2
}

get {
  url: {{base_url_event_service}}/api/v1/eventos/{{event_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

vars:pre-request {
  event_id: 2
  user_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyQGV4YW1wbGUuY29tIiwidXNlcklkIjoxLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc4MTM3MzM1NCwiZXhwIjoxNzgxNDU5NzU0fQ.UC9hHWnNyy_B1x9Cz1B2GAXfIZOahQ6LOFgw6eJcxiw
}

script:post-response {
  const response = res.getBody();
  if (response && response.id) {
    bru.setEnvVar('event_id', response.id);
    console.log('Event ID saved:', response.id);
  }
}
