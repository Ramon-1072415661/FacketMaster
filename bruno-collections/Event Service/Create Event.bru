meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{base_url_event_service}}/api/v1/eventos/admin/create
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "name": "Show da Banda Rock",
