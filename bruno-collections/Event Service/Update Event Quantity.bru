meta {
  name: Update Event Quantity
  type: http
  seq: 5
}

patch {
  url: {{base_url_event_service}}/api/v1/eventos/admin/quantidade/{{event_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "quantidade": 200
  }
}

