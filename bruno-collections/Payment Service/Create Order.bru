meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{base_url_payment_service}}/api/v1/pedidos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  {
    "usuarioId": "{{user_id}}",
    "eventoId": {{event_id}},
    "quantidade": 2,
    "valorUnitario": 75.50,
    "metodoPagamento": "CARTAO_CREDITO",
    "dadosCartao": {
      "numero": "1234.5678.9012.3456",
      "nomeTitular": "Joao Silva",
      "validade": "12/28",
      "cvv": "123",
      "parcelas": 3,
      "bandeira": "VISA"
    }
  }
}

vars:pre-request {
  user_id: 2
  event_id: 2
  user_token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyQGV4YW1wbGUuY29tIiwidXNlcklkIjoxLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc4MTM2NDUzNCwiZXhwIjoxNzgxNDUwOTM0fQ.rLkZeix1o2SNrGEEhrmgOtDZu8yGuJg0QlFyztTnTp4
}

script:post-response {
  const response = res.getBody();
  if (response && response.pedidoId) {
    bru.setEnvVar('order_id', response.pedidoId);
    console.log('Order ID saved:', response.pedidoId);
  }
}
