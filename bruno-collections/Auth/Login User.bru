meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{base_url_event_service}}/auth/login
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {
    "email": "user@example.com",
    "password": "password123"
  }
}
script:post-response {
  const token = res.getBody();
  if (token) {
    bru.setVar('user_token', token);
    console.log('User Token saved:', token);
  }
}