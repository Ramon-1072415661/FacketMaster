meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{base_url_event_service}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Teste User",
    "email": "user@example.com",
    "password": "password123"
  }
}

script:post-response {
  const response = res.getBody();
  if (response && response.id && res.getStatus() === 201) {
    bru.setEnvVar('user_id', String(response.id));
    console.log('User ID saved:', response.id);
  } else {
    console.log('Register failed, status:', res.getStatus());
  }
}
